# Skip git history and CI configs — not needed in the image
.git/
.github/
.gitignore
.dockerignore

# Skip license from the build context (not needed at runtime)
LICENSE

# README.md is NOT in this list — hatchling needs it during pip install.
# Even though we don't ship it in the runtime stage, it must be in the
# build context for the metadata generation step to succeed.

# Dev artifacts
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/
.venv/
venv/

# Tests don't need to ship
tests/

# Action wrapper only used in CI
action/

# Deployment scripts only used outside the container
deploy/

# Local secrets — extra defense in depth
.env*
*.pem
secrets/
service-account-*.json

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

secrets